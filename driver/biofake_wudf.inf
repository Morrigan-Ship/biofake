; BioFake - Virtual WBDI fingerprint sensor (KMDF, root-enumerated)
;
; Install:
;     biofakectl.exe install biofake_wudf.inf          (recommended)
;     devcon.exe install biofake_wudf.inf ROOT\BIOFAKESENSOR   (alternative)
;

[Version]
Signature="$Windows NT$"
Class=Biometric
ClassGuid={53D29EF7-377C-4D14-864B-EB3A85769359}
Provider=%Provider%
CatalogFile=biofake.cat
DriverVer=01/01/2024,1.0.0.0
PnpLockdown=1

[DestinationDirs]
DefaultDestDir = 13
WinBioPluginCopy = 11,WinBioPlugins

[SourceDisksNames]
1 = %DiskId%,,,""

[SourceDisksFiles]
BioFake.sys = 1,,
BioFakeEngineAdapter.dll = 1,,

[Manufacturer]
%Mfg%=Standard,NTamd64

[Standard.NTamd64]
%DeviceName% = BioFake_Install, Root\BIOFAKESENSOR

[BioFake_Install.NT]
CopyFiles = BioFakeCopy, WinBioPluginCopy

[BioFakeCopy]
BioFake.sys

[WinBioPluginCopy]
BioFakeEngineAdapter.dll

[BioFake_Install.NT.Services]
AddService = BioFake, 0x00000002, BioFake_Service_Install

[BioFake_Service_Install]
DisplayName   = %ServiceName%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %13%\BioFake.sys

[BioFake_Install.NT.Wdf]
KmdfService = BioFake, BioFake_wdfsect

[BioFake_wdfsect]
KmdfLibraryVersion = 1.15

[BioFake_Install.NT.HW]
AddReg = Biometric_Device_AddReg, DriverPlugInAddReg, DatabaseAddReg

[Biometric_Device_AddReg]
HKR,,"DeviceCharacteristics",0x10001,0x0100      ; same security checks on relative opens
HKR,,"Security",,"D:P(A;;GA;;;BA)(A;;GA;;;SY)"   ; admins + LocalSystem only

; Windows Biometric Framework plug-in configuration
[DriverPlugInAddReg]
HKR,WinBio\Configurations,DefaultConfiguration,,"0"
HKR,WinBio\Configurations\0,SensorMode,0x10001,1                                  ; Basic - 1, Advanced - 2
HKR,WinBio\Configurations\0,SystemSensor,0x10001,1                                ; UAC/Winlogon - 1
HKR,WinBio\Configurations\0,SensorAdapterBinary,,"WinBioSensorAdapter.DLL"        ; Windows built-in WBDI sensor adapter
HKR,WinBio\Configurations\0,EngineAdapterBinary,,"BioFakeEngineAdapter.DLL"       ; BioFake hash-matching engine
HKR,WinBio\Configurations\0,StorageAdapterBinary,,"WinBioStorageAdapter.DLL"      ; Windows built-in storage adapter
HKR,WinBio\Configurations\0,DatabaseId,,"B10FA4CE-8D21-4E9A-B1F3-2A7C6D5E4F01"    ; unique database GUID

; Register the fingerprint template database with WbioSrvc
[DatabaseAddReg]
HKLM,System\CurrentControlSet\Services\WbioSrvc\Databases\{B10FA4CE-8D21-4E9A-B1F3-2A7C6D5E4F01},BiometricType,0x00010001,0x00000008
HKLM,System\CurrentControlSet\Services\WbioSrvc\Databases\{B10FA4CE-8D21-4E9A-B1F3-2A7C6D5E4F01},Attributes,0x00010001,0x00000001
HKLM,System\CurrentControlSet\Services\WbioSrvc\Databases\{B10FA4CE-8D21-4E9A-B1F3-2A7C6D5E4F01},Format,,"00000000-0000-0000-0000-000000000000"
HKLM,System\CurrentControlSet\Services\WbioSrvc\Databases\{B10FA4CE-8D21-4E9A-B1F3-2A7C6D5E4F01},InitialSize,0x00010001,0x00000020
HKLM,System\CurrentControlSet\Services\WbioSrvc\Databases\{B10FA4CE-8D21-4E9A-B1F3-2A7C6D5E4F01},AutoCreate,0x00010001,0x00000001
HKLM,System\CurrentControlSet\Services\WbioSrvc\Databases\{B10FA4CE-8D21-4E9A-B1F3-2A7C6D5E4F01},AutoName,0x00010001,0x00000001
HKLM,System\CurrentControlSet\Services\WbioSrvc\Databases\{B10FA4CE-8D21-4E9A-B1F3-2A7C6D5E4F01},FilePath,,""
HKLM,System\CurrentControlSet\Services\WbioSrvc\Databases\{B10FA4CE-8D21-4E9A-B1F3-2A7C6D5E4F01},ConnectionString,,""

[Strings]
Provider   = "BioFake Project"
Mfg        = "BioFake Project"
DeviceName = "BioFake Virtual Fingerprint Sensor"
ServiceName = "BioFake Virtual Fingerprint Sensor Driver"
DiskId     = "BioFake Installation Disk"
